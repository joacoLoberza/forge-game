  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>ARTISAN FORGING STEPS:</b>\n\n<b>1. Weapon Selection:</b>\nChoose weapon archetype to forge.\n\n<b>2. Ingot Selection:</b>\nMetal alloy defines mass, edge, and damage.\n\n<b>3. Hammering & Cutting:</b>\n[1] Spread metal with hammer.\n[2] Trim excess with chisel.\n[3] Polish and refine edges.\n\n<b>4. Hearth & Quenching:</b>\n[H] Reheat workpiece if cooling.\n[Space] Quench in water once edge is ready.\n\n<b>5. Assembly:</b>\nAlign handle tang and consecrate weapon."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
