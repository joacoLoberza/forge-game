  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>PASOS DEL FORJADO ARTESANAL:</b>\n\n<b>1. Selecci\xF3n de Arma:</b>\nElige
    el arma a forjar.\n\n<b>2. Selecci\xF3n de Lingote:</b>\nEl metal define peso,
    filo y da\xF1o.\n\n<b>3. Martillado y Corte:</b>\n[1] Extiende el metal con el
    martillo.\n[2] Recorta el exceso con el cincel.\n[3] Lija y pule las aristas.\n\n<b>4.
    Fragua y Templado:</b>\n[H] Recalienta el lingote si se enfr\xEDa.\n[Espacio]
    Templa en agua al completar el filo.\n\n<b>5. Ensamblaje:</b>\nAlinea el mango
    y consagra tu arma."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
